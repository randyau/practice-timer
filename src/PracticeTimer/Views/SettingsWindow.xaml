<Window Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" x:Class="PracticeTimer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="580" Height="520" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Listening">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <TextBlock Text="Start after sound for (seconds)" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0.3" Maximum="5" Value="{Binding StartDelaySeconds}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="2" Text="{Binding StartDelaySeconds, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Pause after quiet for (seconds)" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="30" Value="{Binding StopDelaySeconds}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StopDelaySeconds, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Sound level above room (dB)" VerticalAlignment="Center" ToolTip="Lower = more sensitive" />
                        <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="4" Maximum="30" Value="{Binding SensitivityMarginDb}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SensitivityMarginDb, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="Sparse playing needs (% of time)" VerticalAlignment="Center" ToolTip="For short plucked or staccato notes" />
                        <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Minimum="0.05" Maximum="0.6" Value="{Binding DutyThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DutyThreshold, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Button Content="Calibrate to room noise (3 s of quiet)" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,6" Click="Calibrate_Click" />
                    <Button Content="Open Windows microphone settings (input volume)" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Click="WindowsSound_Click" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                               Text="The red line on the main meter can also be dragged. This app has no gain of its own: raise the input volume in Windows if the mic is too quiet. Lower the sound level if quiet playing is missed. Raise it if room noise starts the clock." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Metronome">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <CheckBox Content="Ignore metronome ticks" IsChecked="{Binding MetronomeFilterEnabled}" />
                    <CheckBox Grid.Row="1" Content="Auto-learn metronomes (tentative, this session only)" IsChecked="{Binding AutoLearnMetronome}" />
                    <DockPanel Grid.Row="2" Margin="0,12,0,6" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Forget all" Padding="8,2" Click="ForgetAll_Click" />
                        <TextBlock Text="Saved metronomes (taught with 'Learn metronome' on the main window)" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox Grid.Row="3" x:Name="MetroList" Background="{DynamicResource Panel}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Use this metronome" />
                                    <StackPanel Grid.Column="1" Margin="6,0">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Delete" Padding="8,3" VerticalAlignment="Top" Tag="{Binding}" Click="DeleteMetronome_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Window">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme" VerticalAlignment="Center" Width="100" />
                        <ComboBox Foreground="#1B1F24" Width="140" SelectedValuePath="Content" SelectedValue="{Binding Theme}">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Content="Larger text" IsChecked="{Binding LargeText}" Margin="0,12,0,0" />
                    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" />
                    <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
                    <CheckBox Content="Chime when the goal is reached" IsChecked="{Binding ChimeEnabled}" Margin="0,12,0,0" />
                    <TextBlock Margin="0,24,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                               Text="Privacy: audio is analysed in memory only. Nothing is recorded or sent anywhere. Only a numeric sound fingerprint of metronomes you teach the app is saved, in your AppData folder." />
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Style="{StaticResource Primary}" Width="90" Click="Ok_Click" IsDefault="True" />
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
