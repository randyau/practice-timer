<Window x:Class="PracticeTimer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" Height="640" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Listening" FontWeight="SemiBold" FontSize="15" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Start after sound for (seconds)" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0.3" Maximum="5" Value="{Binding StartDelaySeconds}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Column="2" Text="{Binding StartDelaySeconds, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="Pause after quiet for (seconds)" VerticalAlignment="Center" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding StopDelaySeconds}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StopDelaySeconds, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="2" Text="Sound level above room (dB)" VerticalAlignment="Center" ToolTip="Lower = more sensitive" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="4" Maximum="30" Value="{Binding SensitivityMarginDb}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SensitivityMarginDb, StringFormat={}{0:0}}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="3" Text="Sparse playing needs (% of time)" VerticalAlignment="Center" ToolTip="For short plucked or staccato notes" />
                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="0.6" Value="{Binding DutyThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DutyThreshold, StringFormat={}{0:P0}}" HorizontalAlignment="Right" />
                </Grid>
                <Button Content="Calibrate to room noise (3 s of quiet)" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6" Click="Calibrate_Click" />

                <TextBlock Text="Metronome" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <CheckBox Content="Ignore metronome ticks" IsChecked="{Binding MetronomeFilterEnabled}" />
                <CheckBox Content="Auto-learn metronomes (tentative, this session only)" IsChecked="{Binding AutoLearnMetronome}" />
                <TextBlock Text="Saved metronomes (taught with 'Learn metronome')" Margin="0,8,0,4" Foreground="{DynamicResource Muted}" />
                <ListBox x:Name="MetroList" Height="130" Background="{DynamicResource Panel}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Use this metronome" />
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBox Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Delete" Padding="8,3" Tag="{Binding}" Click="DeleteMetronome_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Goal and sounds" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Goal minutes (0 = none)" VerticalAlignment="Center" Width="230" />
                    <TextBox Text="{Binding GoalMinutes}" Width="60" />
                </StackPanel>
                <CheckBox Content="Chime when the goal is reached" IsChecked="{Binding ChimeEnabled}" Margin="0,6,0,0" />

                <TextBlock Text="Window" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" />
                <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
                <CheckBox Content="Dark theme" IsChecked="{Binding DarkTheme}" />
                <CheckBox Content="Larger text" IsChecked="{Binding LargeText}" />

                <TextBlock Text="About" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                           Text="Audio is analysed in memory only. Nothing is recorded or sent anywhere. Only a numeric sound fingerprint of metronomes you teach the app is saved, in your AppData folder." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Style="{StaticResource Primary}" Width="90" Click="Ok_Click" IsDefault="True" />
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
