<Window Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" x:Class="PracticeTimer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PracticeTimer.Views"
        Title="Practice Timer" Width="540" Height="640" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid x:Name="Root" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Padding="8,6"
                      ToolTip="Microphone to listen with" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton Content="Auto-listen" IsChecked="{Binding IsAuto}" Margin="0,0,10,0" ToolTip="Clock runs only while it hears playing" />
                <RadioButton Content="Manual" IsChecked="{Binding IsAuto, Converter={x:Static v:InverseBool.Instance}}" ToolTip="Plain stopwatch" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="{Binding ElapsedText}" FontSize="88" FontWeight="Light" HorizontalAlignment="Center" FontFamily="Segoe UI Light" />
            <TextBlock Text="{Binding StatusText}" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Style="{StaticResource Primary}" Content="{Binding StartPauseLabel}" Width="150" FontSize="20" Click="StartPause_Click" />
            <Button Content="Reset" Width="110" FontSize="20" Margin="12,0,0,0" Click="Reset_Click" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,22,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel>
                <v:LevelMeter x:Name="Meter" Height="22" ToolTip="Drag the red line left to hear quieter playing, right to ignore more noise" Level="{Binding Level}" Threshold="{Binding Threshold}" Floor="{Binding Floor}" Kind="{Binding Tag}" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="Green = playing, blue = metronome (ignored). Drag the red trigger line to adjust sensitivity." FontSize="11" Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="{Binding TempoText}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MetronomeText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <v:ProgressRing Grid.Column="1" Width="26" Height="26" Margin="8,0,0,0" Value="{Binding LearnProgress}" Done="{Binding LearnCheck}">
                        <v:ProgressRing.Style>
                            <Style TargetType="v:ProgressRing">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLearning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding LearnCheck}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </v:ProgressRing.Style>
                    </v:ProgressRing>
                    <Button Grid.Column="2" Content="{Binding LearnLabel}" IsEnabled="{Binding CanLearn}" Padding="10,5" Margin="8,0,0,0" Click="Learn_Click"
                            ToolTip="Start your metronome, then press this and let it run for a few seconds. Needs 'Ignore metronome ticks' on." />
                    <Button Grid.Column="3" Content="Forget auto" Padding="10,5" Margin="8,0,0,0" Click="Forget_Click"
                            ToolTip="Clear metronomes the app picked up by itself this session" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Goal (minutes)" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Width="56" Padding="4,3" HorizontalContentAlignment="Center"
                     Text="{Binding GoalMinutes, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Minutes to practice. 0 means no goal." />
            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <ProgressBar Height="12" Maximum="1" Value="{Binding GoalProgress, Mode=OneWay}" />
                <TextBlock Text="{Binding GoalText}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Instrument" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding Instrument, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Instruments}" />
            <TextBlock Grid.Row="1" Text="Note" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="4,3" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Optional note saved with this session" />
        </Grid>

        <TextBlock Grid.Row="6" Text="{Binding TodayText}" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="History" Padding="12,6" Click="History_Click" />
            <Button Content="Settings" Padding="12,6" Margin="8,0,0,0" Click="Settings_Click" />
        </StackPanel>
    </Grid>
</Window>
