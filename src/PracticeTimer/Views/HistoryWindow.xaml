<Window Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" x:Class="PracticeTimer.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Width="640" Height="480" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Sessions">
                <DataGrid x:Name="SessionGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" SortMemberPath="Start" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" SortMemberPath="Seconds" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" />
                        <DataGridTextColumn Header="Instrument" Binding="{Binding Instrument}" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="Delete" Padding="8,2" Tag="{Binding Id}" Click="Delete_Click" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="By day">
                <DataGrid x:Name="DayGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Day" Binding="{Binding Label}" SortMemberPath="Day" Width="*" />
                        <DataGridTextColumn Header="Sessions" Binding="{Binding Sessions}" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" SortMemberPath="Seconds" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="By week">
                <DataGrid x:Name="WeekGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Week starting (Mon)" Binding="{Binding Label}" SortMemberPath="WeekStart" Width="*" />
                        <DataGridTextColumn Header="Sessions" Binding="{Binding Sessions}" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" SortMemberPath="Seconds" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Export CSV..." Padding="12,6" Click="Export_Click" />
            <Button Content="Close" Padding="12,6" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
